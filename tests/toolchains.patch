From 814547f5e09f1414d562a543664a5a09d61ba0df Mon Sep 17 00:00:00 2001
From: PJ Reiniger <pj.reiniger@gmail.com>
Date: Sun, 7 Jun 2026 23:25:14 -0400
Subject: [PATCH] Fix define

---
 MODULE.bazel.lock              | 3 ---
 toolchains/load_toolchains.bzl | 2 +-
 2 files changed, 1 insertion(+), 4 deletions(-)

diff --git a/MODULE.bazel.lock b/MODULE.bazel.lock
index 12bb02d..4822ed3 100644
--- a/MODULE.bazel.lock
+++ b/MODULE.bazel.lock
@@ -117,9 +117,6 @@
             "bzlFile": "@@//toolchains:configure_cross_compiler.bzl",
             "ruleClassName": "configure_cross_compiler",
             "attributes": {
-              "extra_defines": [
-                "-D__FRC_SYSTEMCORE__=1"
-              ],
               "bin_subfolder": "bookworm/bin",
               "bin_prefix": "aarch64-bookworm-linux-gnu-",
               "sysroot_subfolder": "bookworm/aarch64-linux-gnu/sysroot",
diff --git a/toolchains/load_toolchains.bzl b/toolchains/load_toolchains.bzl
index a5238a5..03dc476 100644
--- a/toolchains/load_toolchains.bzl
+++ b/toolchains/load_toolchains.bzl
@@ -47,7 +47,7 @@ def load_toolchains():
     )
     configure_cross_compiler(
         name = "local_systemcore",
-        extra_defines = ["-D__FRC_SYSTEMCORE__=1"],
+        extra_defines = ["-D__FIRST_SYSTEMCORE__=1"],
         bin_subfolder = "bookworm/bin",
         bin_prefix = "aarch64-bookworm-linux-gnu-",
         sysroot_subfolder = "bookworm/aarch64-linux-gnu/sysroot",
