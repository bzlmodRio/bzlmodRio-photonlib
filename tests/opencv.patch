From 3b6b9c4d4b858d4615c8fa65f5e754f50510efb5 Mon Sep 17 00:00:00 2001
From: PJ Reiniger <pj.reiniger@gmail.com>
Date: Sun, 7 Jun 2026 23:12:15 -0400
Subject: [PATCH] Export shared library wrapper

---
 libraries/cpp/opencv/BUILD.bazel | 6 ++++++
 private/cpp/opencv/BUILD.bazel   | 9 +++++++++
 2 files changed, 15 insertions(+)

diff --git a/libraries/cpp/opencv/BUILD.bazel b/libraries/cpp/opencv/BUILD.bazel
index 94c2820..a38f0fe 100644
--- a/libraries/cpp/opencv/BUILD.bazel
+++ b/libraries/cpp/opencv/BUILD.bazel
@@ -15,3 +15,9 @@ alias(
     actual = "@bzlmodrio-opencv//private/cpp/opencv:jni",
     visibility = ["//visibility:public"],
 )
+
+alias(
+    name = "shared",
+    actual = "@bzlmodrio-opencv//private/cpp/opencv:shared",
+    visibility = ["//visibility:public"],
+)
diff --git a/private/cpp/opencv/BUILD.bazel b/private/cpp/opencv/BUILD.bazel
index f75ed1a..c308892 100644
--- a/private/cpp/opencv/BUILD.bazel
+++ b/private/cpp/opencv/BUILD.bazel
@@ -73,3 +73,12 @@ cc_library(
         "@org_wpilib_opencv-cpp_headers//:headers",
     ],
 )
+
+cc_library(
+    name = "shared",
+    linkstatic = 1,
+    visibility = ["@bzlmodrio-opencv//:__subpackages__"],
+    deps = [lib + "_shared_import" for lib in opencv_libraries] + [
+        "@org_wpilib_opencv-cpp_headers//:headers",
+    ],
+)
-- 
2.43.0

